{
  "name": "frontend-ifter",
  "author": "Ixartz (https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@arcjet/next": "1.14.1",
    "@base-ui/react": "^1.9.0",
    "@clerk/localizations": "4.23.0",
    "@clerk/nextjs": "7.9.17",
    "@sentry/nextjs": "10.76.2",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "translation-resilience": "0.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.15.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/prompt-cli": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.64.1",
    "@spotlightjs/spotlight": "4.12.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
